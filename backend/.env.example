# MongoDB connection string
MONGO_URL="mongodb+srv://<username>:<password>@<cluster>/<database>"

# JWT secret key
JWT_SECRET="replace-with-strong-secret"

# Server port
PORT=4000

# development | production
NODE_ENV="development"

# Optional override for frontend URL allowed by CORS.
# If omitted, backend uses:
# development -> http://localhost:5173
# production  -> https://version-2-0-delta.vercel.app
FRONTEND_URL="http://localhost:5173"

# Cloudinary configuration
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# Upload folder
UPLOAD_DIR="./uploads"

# Redis cache URL
# Local Docker example: redis://127.0.0.1:6379
# Upstash production example: rediss://default:<password>@<host>:6379
REDIS_URL="redis://127.0.0.1:6379"

# Optional Redis connect timeout in milliseconds
REDIS_CONNECT_TIMEOUT_MS=5000
